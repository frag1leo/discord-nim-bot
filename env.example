# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# NVIDIA NIM API key from https://build.nvidia.com
NIM_API_KEY=

# NIM base URL - default is NVIDIA's hosted endpoint.
# If self-hosting a NIM container, point this at your own server instead,
# e.g. http://localhost:8000/v1
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Model to use - must support tool/function calling.
# Examples: nvidia/nemotron-3-super-120b-a12b, meta/llama-3.3-70b-instruct
NIM_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional: restrict the bot to only respond when @mentioned (true/false)
REQUIRE_MENTION=true
